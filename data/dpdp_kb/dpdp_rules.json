    "violation_threshold": 0.6,
    "risk_threshold": 0.3,
    "recurrence_bonus": 0.1,
    "enabled": true
  },
  {
    "rule_id": "DPDP-005",
    "clause_id": "DPDP-005",
    "rule_name": "Children's Data Without Guardian Consent",
    "dpdp_section": "Section 9(1)",
    "description": "Personal data of a minor processed without verifiable parental or guardian consent.",
    "severity": "CRITICAL",
    "risk_weight": 1.0,
    "check_type": "weighted_evidence",
    "assigned_agent": "regulation_agent",
    "primary_table": "customer_master",
    "join_tables": [
      "consent_records"
    ],
    "join_key": "customer_id",
    "evidence_signals": [
      {
        "signal_id": "S1",
        "field": "is_minor",
        "operator": "equals",
        "value": true,
        "weight": 0.4,
        "description": "Customer is flagged as a minor — heightened obligations apply under Section 9"
      },
      {
        "signal_id": "S2",
        "field": "guardian_consent_hash",
        "operator": "is_null",
        "value": null,
        "weight": 0.4,
        "description": "No guardian consent record linked to this minor's account"
      },
      {
        "signal_id": "S3",
        "field": "consent_status",
        "operator": "not_in",
        "value": ["active"],
        "weight": 0.2,
        "description": "Consent on file is not in active state even if a record exists"
      }
    ],
    "violation_threshold": 0.7,
    "risk_threshold": 0.2,
    "recurrence_bonus": 0.25,
    "enabled": true
  },
  {
    "rule_id": "DPDP-006",
    "clause_id": "DPDP-006",
    "rule_name": "Unauthorised Third-Party Data Sharing",
    "dpdp_section": "Section 6",
    "description": "Personal data shared with a third party without specific consent or a valid Data Processing Agreement.",
