[
  {
    "rule_id": "DPDP-001",
    "clause_id": "DPDP-001",
    "rule_name": "Invalid or Missing Consent Before Processing",
    "dpdp_section": "Section 6(1)",
    "description": "A processing event relied on consent that was not active or had expired before the event.",
    "severity": "HIGH",
    "risk_weight": 0.9,
    "check_type": "weighted_evidence",
    "assigned_agent": "regulation_agent",
    "primary_table": "transaction_events",
    "join_tables": [
      "consent_records"
    ],
    "join_key": "consent_id",
    "evidence_signals": [
      {
        "signal_id": "S1",
        "field": "consent_status",
        "operator": "in",
        "value": [
          "expired",
          "revoked",
          "withdrawn"
        ],
        "weight": 0.5,
        "description": "Consent was not active at the time of processing"
      },
      {
        "signal_id": "S2",
        "field": "expiry_date",
        "operator": "less_than",
        "value": "event_date",
        "weight": 0.5,
        "description": "Consent expired before the processing event date"
      }
    ],
    "violation_threshold": 0.5,
    "risk_threshold": 0.25,
    "recurrence_bonus": 0.2,
    "enabled": true
  },
  {
    "rule_id": "DPDP-002",
    "clause_id": "DPDP-002",
    "rule_name": "Processing Beyond Stated Purpose",
    "dpdp_section": "Section 5",
    "description": "Personal data used for a purpose beyond what was stated in the notice and consented to.",
    "severity": "HIGH",
    "risk_weight": 0.85,
    "check_type": "weighted_evidence",
    "assigned_agent": "regulation_agent",
    "primary_table": "transaction_events",
    "join_tables": [
      "consent_records"
    ],
    "join_key": "consent_id",
    "evidence_signals": [
      {
        "signal_id": "S1",
        "field": "consented_purpose",
        "operator": "not_matches",
        "value": "processing_purpose",
        "weight": 1.0,
        "description": "Processing purpose differs from the consented purpose"
      }
    ],
    "violation_threshold": 0.5,
    "risk_threshold": 0.25,
    "recurrence_bonus": 0.2,
    "enabled": true
  },
  {
    "rule_id": "DPDP-003",
    "clause_id": "DPDP-003",
    "rule_name": "Retention Beyond Allowed Period",
    "dpdp_section": "Section 8(7)",
    "description": "Personal data retained after its retention expiry date without a legal hold.",
    "severity": "HIGH",
    "risk_weight": 0.8,
    "check_type": "weighted_evidence",
    "assigned_agent": "audit_agent",
    "primary_table": "data_lifecycle",
    "join_tables": [],
    "join_key": null,
    "evidence_signals": [
      {
        "signal_id": "S1",
        "field": "retention_expiry_date",
        "operator": "less_than_today",
        "value": null,
        "weight": 0.45,
        "description": "Retention expiry date has passed \u00e2\u20ac\u201d data should have been deleted"
      },
      {
        "signal_id": "S2",
        "field": "retention_status",
        "operator": "in",
        "value": [
          "expired",
          "pending_deletion"
        ],
        "weight": 0.3,
        "description": "Retention status indicates data is past its allowed window"
      },
      {
        "signal_id": "S3",
        "field": "legal_hold_flag",
        "operator": "equals",
        "value": false,
        "weight": 0.25,
        "description": "No legal hold is in place to justify extended retention"
      }
    ],
    "violation_threshold": 0.55,
    "risk_threshold": 0.3,
    "recurrence_bonus": 0.15,
    "enabled": true
  },
  {
    "rule_id": "DPDP-004",
    "clause_id": "DPDP-004",
