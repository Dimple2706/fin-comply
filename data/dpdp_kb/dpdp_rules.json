      },
      {
        "signal_id": "S3",
        "field": "dpa_signed",
        "operator": "equals",
        "value": false,
        "weight": 0.25,
        "description": "No signed Data Processing Agreement on file for the receiving processor"
      },
      {
        "signal_id": "S4",
        "field": "is_cross_border",
        "operator": "equals",
        "value": true,
        "weight": 0.1,
        "description": "Transfer is cross-border \u00e2\u20ac\u201d additional DPDP Chapter V obligations apply"
      }
    ],
    "violation_threshold": 0.55,
    "risk_threshold": 0.3,
    "recurrence_bonus": 0.2,
    "enabled": true
  },
  {
