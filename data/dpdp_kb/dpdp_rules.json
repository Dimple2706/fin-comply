        "weight": 0.4,
        "description": "The recorded protection type is absent, obsolete, or not encryption"
      }
    ],
    "violation_threshold": 0.5,
    "risk_threshold": 0.25,
    "recurrence_bonus": 0.2,
    "enabled": true
  },
