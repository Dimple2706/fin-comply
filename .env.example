# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ── AI / LLM ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# SHA-256 token hashes mapped to users. Never commit the original tokens.
# Example shape: {"<64-character-sha256>":{"username":"admin","role":"admin","authorized_tenants":["QUICKLOAN-001"]}}
FINCOMPLY_CREDENTIALS={}

# Optional: persist the latest SHAP/LIME diagnostic JSON outside request flow.
# ML_EXPLANATION_OUTPUT_DIR=C:/secure/fincomply-explanations

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random secret before deploying to production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=fin-comply-dev-secret-change-in-production
TOKEN_ISSUER=fincomply-api
TOKEN_AUDIENCE=fincomply-web
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Pytest ignores DB_NAME and uses this isolated database. The name must contain
# the word "test" so test collection fails closed instead of modifying real data.
FINCOMPLY_TEST_DB_NAME=dpdp_test_isolated
